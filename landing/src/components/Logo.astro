---
// Shield-P mark from app/public/favicon.svg, with optional wordmark.
interface Props { size?: number; wordmark?: boolean }
const { size = 34, wordmark = true } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <path d="M32 9 51 16v14c0 12.2-7.5 21.5-19 25-11.5-3.5-19-12.8-19-25V16l19-7Z" fill="#c8ff67" />
    <path d="M24 21h10.5c7 0 11.5 3.8 11.5 10s-4.5 10-11.5 10H30v8h-6V21Zm6 6v8h4.2c3.6 0 5.5-1.3 5.5-4s-1.9-4-5.5-4H30Z" fill="#111a17" />
  </svg>
  {wordmark && <span class="logo-word">privara</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo svg { filter: drop-shadow(0 0 14px rgba(200, 255, 103, 0.28)); }
  .logo-word { font-weight: 800; font-size: 22px; letter-spacing: -0.05em; line-height: 1; }
</style>
