---
import Icon from "./Icon.astro";
import { APP_URL } from "../data/site";
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="pill" data-reveal><span class="live-dot"></span>Live on Stacks mainnet</span>
      <h1 id="hero-title" data-reveal style="--delay: 80ms">Get paid without exposing your <span class="accent">wallet.</span></h1>
      <p class="lead" data-reveal style="--delay: 160ms">
        Anyone can pay your normal Stacks address or .btc name. Privara settles the
        funds to a fresh one-time address that only you can find, so your everyday wallet never appears as the destination.
      </p>
      <div class="hero-ctas" data-reveal style="--delay: 240ms">
        <a class="btn btn-primary" href={APP_URL}>Launch app <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="#demo"><Icon name="play" size={16} /> Watch the demo</a>
      </div>
      <ul class="hero-meta" data-reveal style="--delay: 320ms" aria-label="Supported assets and facts">
        <li><span class="dot" style="background: var(--btc)"></span>sBTC</li>
        <li><span class="dot" style="background: var(--usdc)"></span>USDCx</li>
        <li><span class="dot" style="background: var(--stx)"></span>STX</li>
        <li class="sep" aria-hidden="true"></li>
        <li>Keys never leave your browser</li>
      </ul>
    </div>

    <div class="hero-visual" data-reveal style="--delay: 200ms">
      <svg viewBox="0 0 560 560" role="img" aria-labelledby="route-title route-desc">
        <title id="route-title">How a Privara payment is routed</title>
        <desc id="route-desc">A sender pays bob.btc. The payment passes through a router and settles to a fresh one-time address. Bob's everyday wallet is not the destination.</desc>
        <defs>
          <linearGradient id="card" x1="0" y1="0" x2="0.6" y2="1">
            <stop offset="0" stop-color="#18261f" /><stop offset="1" stop-color="#111b17" />
          </linearGradient>
          <linearGradient id="fresh" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#1f3a2b" /><stop offset="1" stop-color="#132219" />
          </linearGradient>
          <filter id="glow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="16" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          <path id="route" d="M185 198 V 300 H 252" />
        </defs>

        <!-- Sender card -->
        <g class="float-a">
          <rect x="20" y="22" width="330" height="176" rx="20" fill="url(#card)" stroke="rgba(214,255,190,.12)" />
          <text x="44" y="56" class="t-mono t-mint" font-size="11.5" letter-spacing="2">SEND PRIVATELY</text>
          <circle cx="318" cy="51" r="13" fill="#f7931a" />
          <text x="318" y="56" text-anchor="middle" class="t-sans" font-size="14" font-weight="800" fill="#fff">₿</text>
          <rect x="44" y="72" width="282" height="46" rx="12" fill="rgba(0,0,0,.28)" stroke="rgba(169,255,120,.3)" />
          <text x="62" y="101" class="t-sans t-text" font-size="18" font-weight="700">bob.btc</text>
          <text x="306" y="100" text-anchor="end" class="t-mono t-muted" font-size="11">SP2W9H…Q1A71</text>
          <circle cx="54" cy="141" r="8" fill="rgba(169,255,120,.18)" stroke="#a9ff78" />
          <path d="M50.5 141.2l2.4 2.4 4.6-4.8" stroke="#a9ff78" stroke-width="1.8" fill="none" stroke-linecap="round" />
          <text x="70" y="145.5" class="t-sans t-mint" font-size="13" font-weight="700">Privacy keys registered</text>
          <text x="44" y="180" class="t-sans t-text" font-size="21" font-weight="800">0.0001 <tspan class="t-muted" font-weight="600" font-size="15">sBTC</tspan></text>
          <text x="326" y="179" text-anchor="end" class="t-mono t-muted" font-size="11">SIP-018 signed</text>
        </g>

        <!-- Route -->
        <path d="M185 198 V 274" stroke="rgba(214,255,190,.28)" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round" />
        <path d="M211 300 H 252" stroke="#a9ff78" stroke-opacity=".7" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round" />
        <path d="M178 326 L 158 420" stroke="rgba(214,255,190,.18)" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round" />
        <g transform="translate(168 373)">
          <circle r="13" fill="#0a110e" stroke="#ff6a55" stroke-width="1.6" />
          <path d="M-4.5 -4.5 4.5 4.5M4.5 -4.5 -4.5 4.5" stroke="#ff6a55" stroke-width="2" stroke-linecap="round" />
        </g>
        <g transform="translate(185 300)">
          <path d="M0 -26 22.5 -13 22.5 13 0 26 -22.5 13 -22.5 -13Z" fill="#141f1a" stroke="#f3ead8" stroke-opacity=".7" stroke-width="1.5" />
          <path d="M-8 0h16M3 -5l5 5-5 5" stroke="#f3ead8" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <text x="124" y="304" text-anchor="end" class="t-mono t-muted" font-size="11">router</text>

        <g class="motion" aria-hidden="true">
          {[0, 0.8, 1.6].map((begin) => (
            <circle r="5" fill="#a9ff78">
              <animateMotion dur="2.4s" begin={`${begin}s`} repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
                <mpath href="#route" />
              </animateMotion>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="2.4s" begin={`${begin}s`} repeatCount="indefinite" />
            </circle>
          ))}
        </g>

        <!-- Fresh one-time address -->
        <g class="float-b">
          <rect x="252" y="238" width="288" height="126" rx="20" fill="url(#fresh)" stroke="#a9ff78" stroke-opacity=".75" filter="url(#glow)" />
          <rect x="252" y="238" width="288" height="126" rx="20" fill="url(#fresh)" stroke="#a9ff78" stroke-width="1.5" />
          <text x="276" y="270" class="t-mono t-mint" font-size="11.5" letter-spacing="2">ONE-TIME ADDRESS</text>
          <text x="276" y="304" class="t-mono t-text" font-size="19">SP3VQ8M2…X7KD4</text>
          <text x="276" y="338" class="t-sans t-muted" font-size="13" font-weight="600"><tspan class="t-mint">+0.0001 sBTC</tspan> · only Bob can find it</text>
        </g>

        <!-- Everyday wallet, untouched -->
        <g class="float-c" opacity=".62">
          <rect x="40" y="420" width="258" height="98" rx="18" fill="url(#card)" stroke="rgba(214,255,190,.1)" />
          <rect x="60" y="443" width="48" height="48" rx="14" fill="rgba(255,255,255,.04)" stroke="rgba(214,255,190,.12)" />
          <g transform="translate(72 455)" stroke="#98a59e" stroke-width="1.6" fill="none"><rect x="1.5" y="4" width="21" height="16" rx="3.5" /><path d="M16.5 12h2.5M1.5 8h17a3.5 3.5 0 0 0-3.5-4H5" /></g>
          <text x="124" y="463" class="t-sans t-text" font-size="15" font-weight="700">Bob's everyday wallet</text>
          <text x="124" y="486" class="t-mono" font-size="11" fill="#ff6a55">not the destination</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(40px, 7vw, 96px) 0 clamp(80px, 10vw, 130px); }
  .hero-glow {
    position: absolute; inset: -20% -10% auto; height: 120%; pointer-events: none;
    background:
      radial-gradient(700px 500px at 78% 38%, rgba(169, 255, 120, 0.14), transparent 65%),
      radial-gradient(900px 600px at 15% 0%, rgba(23, 57, 44, 0.9), transparent 70%);
  }
  .hero-grid {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.6;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, black 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, black 10%, transparent 75%);
  }
  .hero-inner { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero-copy { display: grid; gap: 28px; justify-items: start; }
  .hero-copy .lead { max-width: 560px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; color: var(--muted); font-size: 14px; font-weight: 600; }
  .hero-meta li { display: inline-flex; align-items: center; gap: 8px; }
  .hero-meta .dot { width: 9px; height: 9px; border-radius: 50%; }
  .hero-meta .sep { width: 1px; height: 16px; background: var(--line-2); }
  .hero-visual { width: 100%; max-width: 580px; justify-self: end; }
  .hero-visual svg { width: 100%; height: auto; overflow: visible; }
  .t-mono { font-family: var(--mono); }
  .t-sans { font-family: var(--sans); }
  .t-mint { fill: var(--mint); }
  .t-text { fill: var(--text); }
  .t-muted { fill: var(--muted); }
  .float-a { animation: float 7s ease-in-out infinite; }
  .float-b { animation: float 7s ease-in-out -2.3s infinite; }
  .float-c { animation: float 7s ease-in-out -4.6s infinite; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .motion { display: none; } }
  @media (max-width: 520px) {
    .hero-ctas { width: 100%; }
    .hero-ctas .btn { flex: 1 1 100%; }
    .hero-meta .sep { display: none; }
  }
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { justify-self: center; max-width: 520px; }
  }
</style>
