FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.scripts.json ./
COPY relayer ./relayer
COPY sdk ./sdk

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787 \
    PRIVARA_PROCESSED_STORE=/data/relayer-processed.json

RUN mkdir -p /data && chown -R node:node /app /data
USER node

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["npm", "run", "relayer:serve"]
