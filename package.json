{
  "name": "privara-tests",
  "version": "1.0.0",
  "description": "Run unit tests on Privara contracts.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts",
    "deploy:stealth-registry:testnet": "tsx scripts/deploy-stealth-registry.ts",
    "deploy:router-m2:testnet": "tsx scripts/deploy-router-m2.ts",
    "deploy:router-m2-sbtc:testnet": "PRIVARA_ROUTER_NAME=privara-router-m2-sbtc PRIVARA_ASSET=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1.sbtc-token tsx scripts/deploy-router-m2.ts",
    "deploy:sponsored-spend:testnet": "tsx scripts/deploy-sponsored-spend.ts",
    "deploy:sip010-trait:mainnet": "PRIVARA_NETWORK=mainnet tsx scripts/deploy-sip010-trait.ts",
    "deploy:stealth-registry:mainnet": "PRIVARA_NETWORK=mainnet tsx scripts/deploy-stealth-registry.ts",
    "deploy:router-m2-sbtc:mainnet": "PRIVARA_NETWORK=mainnet PRIVARA_ROUTER_NAME=privara-router-m2-sbtc PRIVARA_ASSET=SM3VDXK3WZZSA84XXFKAFAF15NNZX32CTSG82JFQ4.sbtc-token tsx scripts/deploy-router-m2.ts",
    "deploy:sponsored-spend:mainnet": "PRIVARA_NETWORK=mainnet tsx scripts/deploy-sponsored-spend.ts",
    "mainnet:deployer-address": "PRIVARA_NETWORK=mainnet tsx scripts/show-deployer-address.ts",
    "register:stealth-keys": "tsx scripts/register-stealth-keys.ts",
    "acceptance:stealth:testnet": "tsx scripts/testnet-stealth-acceptance.ts",
    "acceptance:http-paid:testnet": "tsx scripts/testnet-http-paid-acceptance.ts",
    "acceptance:http-paid:sbtc:testnet": "PRIVARA_ROUTER=STXB1YYJ4253QA0N20F12ZEQVX02HN7QRW2TJXT0.privara-router-m2-sbtc PRIVARA_ASSET=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1.sbtc-token PRIVARA_TOKEN_NAME=sbtc-token PRIVARA_TOKEN_SPONSOR_FEE=1200 PAYER_ACCOUNT_INDEX=1 tsx scripts/testnet-http-paid-acceptance.ts",
    "scan:stealth:testnet": "tsx scripts/scan-testnet-announcements.ts",
    "create:sponsored-sweep": "tsx scripts/create-sponsored-sweep.ts",
    "sponsor:sweep:testnet": "tsx scripts/sponsor-sweep.ts",
    "relayer:serve": "tsx relayer/src/server.ts",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "acceptance:testnet": "tsx scripts/testnet-acceptance.ts",
    "gen-wallets": "tsx scripts/gen-wallets.ts",
    "mint": "tsx scripts/mint.ts",
    "deposit": "tsx scripts/deposit.ts",
    "create-intent": "tsx scripts/create-intent.ts",
    "settle": "tsx scripts/settle.ts",
    "status": "tsx scripts/status.ts",
    "register-relayer": "tsx scripts/register-relayer.ts",
    "shakeout": "tsx scripts/shakeout.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.9.0",
    "@stacks/transactions": "^7.2.0",
    "@stacks/wallet-sdk": "^7.6.0",
    "chokidar-cli": "^3.0.0",
    "vitest": "^4.0.7",
    "vitest-environment-clarinet": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
