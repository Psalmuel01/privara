{
  "name": "@privara-stacks/sdk",
  "version": "0.1.0-beta.1",
  "description": "TypeScript SDK for Privara SIP-010 intents and stealth-address payments on Stacks",
  "license": "MIT",
  "author": "Samuel Dahunsi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Psalmuel01/privara.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/Psalmuel01/privara/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/Psalmuel01/privara/issues"
  },
  "keywords": [
    "stacks",
    "sbtc",
    "sip-010",
    "sip-018",
    "stealth-addresses",
    "payments",
    "privacy"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@noble/secp256k1": "^1.7.1",
    "@stacks/common": "^7.0.2",
    "@stacks/network": "^7.0.2",
    "@stacks/transactions": "^7.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
