---
import Icon from "./Icon.astro";
import { YOUTUBE_ID } from "../data/site";
---
<section class="section demo" id="demo" aria-labelledby="demo-title">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow">See it in 78 seconds</span>
      <h2 id="demo-title">From <span class="accent">bob.btc</span> to a fresh address.</h2>
    </div>
    <div class="player card" data-reveal data-player>
      <!-- Click-to-load: nothing is requested from YouTube until the visitor presses play. -->
      <button class="poster" type="button" data-play aria-label="Play the Privara demo video">
        <img src="/demo-poster.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
        <span class="play"><Icon name="play" size={30} /></span>
      </button>
      <template data-embed>
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_ID}?autoplay=1&rel=0&modestbranding=1`}
          title="Privara — Private Payments on Stacks"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </template>
    </div>
    <p class="note" data-reveal>Plays from YouTube when you press play. <a href={`https://youtu.be/${YOUTUBE_ID}`} target="_blank" rel="noopener">Open on YouTube <Icon name="external" size={14} /></a></p>
  </div>
</section>

<style>
  .player { position: relative; aspect-ratio: 16 / 9; overflow: hidden; padding: 0; max-width: 1060px; margin: 0 auto; box-shadow: 0 50px 120px -50px rgba(169, 255, 120, 0.35); }
  .player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .poster { position: absolute; inset: 0; border: 0; padding: 0; background: #000; cursor: pointer; }
  .poster img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease), filter 0.5s; }
  .poster:hover img { transform: scale(1.02); filter: brightness(0.85); }
  .play { position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 -46px; border-radius: 50%; display: grid; place-items: center; background: var(--mint); color: var(--ink); box-shadow: 0 0 0 12px rgba(169, 255, 120, 0.18), 0 20px 50px rgba(0, 0, 0, 0.5); transition: transform 0.35s var(--ease); }
  .play :global(svg) { margin-left: 4px; }
  .poster:hover .play { transform: scale(1.08); }
  .note { text-align: center; margin-top: 18px; color: var(--dim); font-size: 14px; }
  .note a { color: var(--muted); display: inline-flex; align-items: center; gap: 6px; border-bottom: 1px solid var(--line-2); }
  .note a:hover { color: var(--text); }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-player]").forEach((player) => {
    const button = player.querySelector<HTMLButtonElement>("[data-play]");
    const template = player.querySelector<HTMLTemplateElement>("[data-embed]");
    button?.addEventListener("click", () => {
      if (!template) return;
      player.append(template.content.cloneNode(true));
      button.remove();
    }, { once: true });
  });
</script>
