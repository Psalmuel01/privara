# Public mainnet build configuration. This file must never contain private keys.
VITE_PRIVARA_NETWORK=mainnet
VITE_PRIVARA_RELAYER_URL=https://REPLACE_WITH_MAINNET_RELAYER
VITE_STACKS_API_URL=https://api.hiro.so
VITE_PRIVARA_FALLBACK_REGISTRY=REPLACE_DEPLOYER.privara-stealth-registry
VITE_PRIVARA_FALLBACK_ROUTER=REPLACE_DEPLOYER.privara-router-m2-sbtc
VITE_PRIVARA_FALLBACK_ASSET=SM3VDXK3WZZSA84XXFKAFAF15NNZX32CTSG82JFQ4.sbtc-token
# Separate native-STX router. Do not point this at the unused direct-payment contract.
VITE_PRIVARA_STX_ROUTER=REPLACE_DEPLOYER.privara-stx-router-v1
# Enable only after deploying and confirming the dedicated USDCx router.
VITE_PRIVARA_USDCX_ROUTER=SP1H7G0B7BBM991P2KA77R0XHDRNYCWH8H808K7AE.privara-router-m2-usdcx
