---
const steps = [
  {
    n: "01",
    title: "Create your privacy identity",
    body: "Privara generates spending and viewing keys in your browser. You export an encrypted backup, prove it restores, and only then register the two public keys against your normal address.",
    detail: "Registration stays locked until the backup is restore-verified.",
  },
  {
    n: "02",
    title: "Get paid at your normal address",
    body: "A sender enters your address or .btc name. Their browser derives a fresh one-time address from your public keys, they sign the exact payment, and a relayer settles it through the asset's router.",
    detail: "Every number on the review screen is the number that gets signed.",
  },
  {
    n: "03",
    title: "Scan, then spend",
    body: "Your browser reads the router's encrypted announcements and recognises the payments meant for you. Pay someone directly from the one-time balance or withdraw to an address you choose.",
    detail: "Matching and key derivation happen locally — nothing private is uploaded.",
  },
];
---
<section class="section how" id="how" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">How it works</span>
      <h2 id="how-title">Three steps. No special address to share.</h2>
      <p class="lead">Senders use the address they already know. Recipients set up once and keep every incoming payment off their everyday wallet.</p>
    </div>
    <ol class="steps">
      {steps.map((step, i) => (
        <li class="card step" data-reveal style={`--delay: ${i * 110}ms`}>
          <span class="step-n">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <p class="step-detail">{step.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: step; position: relative; }
  .step { padding: 34px 30px; display: grid; gap: 14px; align-content: start; position: relative; overflow: hidden; }
  .step::before { content: ""; position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, var(--mint), transparent); opacity: 0.6; }
  .step-n { font-family: var(--mono); font-size: 14px; color: var(--ink); background: var(--mint); width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; font-weight: 500; margin-bottom: 8px; box-shadow: 0 0 30px -6px rgba(169, 255, 120, 0.6); }
  .step p { color: var(--muted); }
  .step-detail { margin-top: auto; padding-top: 16px; border-top: 1px dashed var(--line); font-family: var(--mono); font-size: 13.5px; color: var(--cream) !important; line-height: 1.55; }
  @media (max-width: 960px) { .steps { grid-template-columns: 1fr; } }
</style>
