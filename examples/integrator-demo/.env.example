# Local development uses Vite's /privara-api proxy by default.
VITE_PRIVARA_RELAYER_URL=/privara-api
VITE_STACKS_API_URL=https://api.hiro.so

# A deployed browser origin must be allowlisted by Privara before using the hosted
# relayer directly, for example:
# VITE_PRIVARA_RELAYER_URL=https://privara-production.up.railway.app
