# Privara mainnet relayer. Copy these public values into Railway, then add secrets
# through Railway's secret-variable UI. Never commit RELAYER_KEY or SPONSOR_KEY.
PRIVARA_NETWORK=mainnet
PRIVARA_CORE_ADDRESS=REPLACE_DEPLOYER
PRIVARA_ROUTER=REPLACE_DEPLOYER.privara-router-m2-sbtc
PRIVARA_ASSET=SM3VDXK3WZZSA84XXFKAFAF15NNZX32CTSG82JFQ4.sbtc-token
PRIVARA_TOKEN_NAME=sbtc-token
PRIVARA_SPEND_CONTRACT=REPLACE_DEPLOYER.privara-sponsored-spend-v2

# Secret variables: use a dedicated operational mainnet wallet, not the deployer.
RELAYER_KEY=REPLACE_IN_RAILWAY_SECRET_UI
SPONSOR_KEY=REPLACE_IN_RAILWAY_SECRET_UI
PRIVARA_SPONSOR_FEE_RECIPIENT=REPLACE_TREASURY_MAINNET_ADDRESS

# These are launch policy inputs, not protocol constants. Review economics before use.
PRIVARA_TOKEN_SPONSOR_FEE=REPLACE_WITH_REVIEWED_ATOMIC_SBTC_FEE
PRIVARA_MAX_SPONSOR_FEE=REPLACE_WITH_REVIEWED_MICRO_STX_CAP
PRIVARA_MAX_INTENT_AMOUNT=REPLACE_WITH_REVIEWED_ATOMIC_SBTC_LIMIT
PRIVARA_MAX_SWEEP_AMOUNT=REPLACE_WITH_REVIEWED_ATOMIC_SBTC_LIMIT
PRIVARA_MAX_RELAYER_FEE_BPS=100
PRIVARA_MAX_SPONSOR_TX_BYTES=4096
PRIVARA_SPONSOR_RATE_LIMIT=10
PRIVARA_SPONSOR_RATE_WINDOW_MS=60000
PRIVARA_PROCESSED_STORE=/data/relayer-processed-mainnet.json
PRIVARA_ALLOWED_ORIGINS=https://REPLACE_WITH_MAINNET_APP_ORIGIN
STACKS_API_URL=https://api.hiro.so
HOST=0.0.0.0
PORT=8787
